{
    admin off
    auto_https off
    servers {
        trusted_proxies static 127.0.0.1/32 ::1/128
        client_ip_headers CF-Connecting-IP
        trusted_proxies_strict
    }
}

http://:13080 {
    bind 127.0.0.1
    encode gzip zstd
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
    request_body {
        max_size 1MB
    }
    route {
        # The authenticated embedding RPC and deep health probe stay local.
        @internal path /internal /internal/* /api/internal /api/internal/* /health/ready /health/ready/* /api/health/ready /api/health/ready/* /docs /redoc /openapi.json /api/docs /api/redoc /api/openapi.json
        respond @internal "Not found" 404
        @api path /api /api/*
        handle @api {
            uri strip_prefix /api
            reverse_proxy 127.0.0.1:18800 {
                header_up X-IL-Client-IP {client_ip}
            }
        }
        @direct path /bridge /bridge/* /summaries /summaries/*
        respond @direct "Not found" 404
        reverse_proxy 127.0.0.1:13013 {
            header_up X-IL-Client-IP {client_ip}
        }
    }
}
